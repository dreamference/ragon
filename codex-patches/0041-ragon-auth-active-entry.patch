+
+fn key_auth(key: &str) -> AuthDotJson {
+    AuthDotJson {
+        auth_mode: Some(AuthMode::ApiKey),
+        openai_api_key: Some(key.to_string()),
+        tokens: None,
+        last_refresh: None,
+        agent_identity: None,
+        personal_access_token: None,
+        bedrock_api_key: None,
+        bedrock_access_keys: None,
+    }
+}
+
+fn entries_file(active: &str, keys: &[&str]) -> serde_json::Value {
+    let entries: serde_json::Map<_, _> = keys
+        .iter()
+        .map(|k| (k.to_string(), serde_json::to_value(key_auth(k)).unwrap()))
+        .collect();
+    json!({"version": 2, "active": active, "entries": entries})
+}
+
+#[test]
+fn multi_entry_file_one_three_and_a_switch() -> anyhow::Result<()> {
+    let home = tempdir()?;
+    let storage = FileAuthStorage::new(home.path().to_path_buf());
+    let path = get_auth_file(home.path());
+    let put = |v: &serde_json::Value| std::fs::write(&path, v.to_string());
+
+    put(&entries_file("a", &["a"]))?;
+    assert_eq!(storage.load()?, Some(key_auth("a")));
+
+    put(&entries_file("b", &["a", "b", "c"]))?;
+    assert_eq!(storage.load()?, Some(key_auth("b")));
+    storage.save(&key_auth("b2"))?;
+    let file: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(&path)?)?;
+    assert_eq!(file["active"], "b");
+    assert_eq!(file["entries"]["a"], serde_json::to_value(key_auth("a"))?);
+    assert_eq!(file["entries"]["b"], serde_json::to_value(key_auth("b2"))?);
+    assert_eq!(file["entries"]["c"], serde_json::to_value(key_auth("c"))?);
+
+    let mut switched = file.clone();
+    switched["active"] = json!("c");
+    put(&switched)?;
+    assert_eq!(storage.load()?, Some(key_auth("c")));
+
+    assert!(storage.delete()?);
+    let file: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(&path)?)?;
+    assert_eq!(file["entries"].as_object().unwrap().len(), 2);
+    assert_eq!(storage.load()?, None);
+    Ok(())
+}
+
+#[test]
+fn file_without_version_keeps_the_old_layout() -> anyhow::Result<()> {
+    let home = tempdir()?;
+    let storage = FileAuthStorage::new(home.path().to_path_buf());
+    storage.save(&key_auth("x"))?;
+    let file: serde_json::Value =
+        serde_json::from_str(&std::fs::read_to_string(get_auth_file(home.path()))?)?;
+    assert_eq!(file, serde_json::to_value(key_auth("x"))?);
+    assert!(storage.delete()?);
+    assert!(!get_auth_file(home.path()).exists());
+    Ok(())
+}
