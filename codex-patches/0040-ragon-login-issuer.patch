 pub(super) const DEFAULT_ISSUER: &str = "https://auth.openai.com";
+
+/// The issuer: `RAGON_ISSUER`, else top-level `chatgpt_base_url` in `config.toml` less `/backend-api`, else the constant.
+pub(super) fn issuer() -> String {
+    let set =
+        |v: String| Some(v.trim().trim_end_matches('/').to_string()).filter(|v| !v.is_empty());
+    std::env::var("RAGON_ISSUER")
+        .ok()
+        .and_then(set)
+        .or_else(|| {
+            let home = std::env::var_os("CODEX_HOME")
+                .map(std::path::PathBuf::from)
+                .or_else(|| {
+                    std::env::var_os("HOME").map(|h| std::path::Path::new(&h).join(".codex"))
+                })?;
+            let text = std::fs::read_to_string(home.join("config.toml")).ok()?;
+            text.lines()
+                .take_while(|l| !l.trim_start().starts_with('['))
+                .find_map(|l| {
+                    let (k, v) = l.split_once('=')?;
+                    (k.trim() == "chatgpt_base_url")
+                        .then(|| v.trim().trim_matches(['"', '/']).strip_suffix("/backend-api"))?
+                        .and_then(|v| set(v.into()))
+                })
+        })
+        .unwrap_or_else(|| DEFAULT_ISSUER.to_string())
+}
 const DEFAULT_PORT: u16 = 1455;
 // Keep in sync with the Codex CLI Hydra redirect URI allow-list.
 const FALLBACK_PORT: u16 = 1457;
