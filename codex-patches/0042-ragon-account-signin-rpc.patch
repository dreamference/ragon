 use codex_login::LoginOnboardingEntrypoint;
@@ -1002,2 +1005,29 @@
 
+    pub(crate) async fn ragon_sign_in(
+        &self,
+        request_id: ConnectionRequestId,
+        params: RagonSignInParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let create = params.mode == RagonSignInMode::Create;
+        let home = self.config.codex_home.to_path_buf();
+        let done =
+            ragon_launcher::auth::signin_rpc::sign_in(&home, create, &params.username, &params.password).await;
+        let result = done.map_err(|r| JSONRPCErrorError { code: r.code, message: r.message, data: None });
+        if result.is_ok() {
+            self.auth_manager.reload();
+        }
+        let response = result.map(|s| RagonSignInResponse::Ragon {
+            username: s.username,
+            role: s.role,
+            must_change_password: s.must_change_password,
+        });
+        let signed_in = response.is_ok();
+        self.outgoing.send_result(request_id, response).await;
+        if signed_in {
+            let payload = self.current_account_updated_notification();
+            self.outgoing.send_server_notification(ServerNotification::AccountUpdated(payload)).await;
+        }
+        Ok(None)
+    }
+
